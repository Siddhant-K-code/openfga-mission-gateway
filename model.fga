model
  schema 1.1

# Durable authority lives in this graph. A Mission token contributes its
# executor and allowed_call relationships as contextual tuples for one Check.

type user

type agent

type mcp_server
  relations
    define operator: [user]

type mcp_tool
  relations
    define server: [mcp_server]
    define invoker: [user] or operator from server
    define can_invoke: invoker

type mcp_call
  relations
    # A canonical call captures server, tool, and the policy-relevant part of
    # the input. It can inherit tool access or receive a direct user grant.
    define tool: [mcp_tool]
    define invoker: [user] or can_invoke from tool
    define can_invoke: invoker

type mission
  relations
    define requester: [user]
    define executor: [agent]
    define allowed_call: [mcp_call]
