model
  schema 1.1

# Durable authority lives in this graph. The gateway contributes its trusted
# tool-to-call topology plus a Mission token's executor and allowed_call
# relationships as contextual tuples for one Check.

type user

type agent

type mcp_server
  relations
    define operator: [user, agent]

type mcp_tool
  relations
    define server: [mcp_server]
    define invoker: [user, agent] or operator from server
    define can_invoke: invoker

type mcp_call
  relations
    # A canonical call captures server, tool, and the policy-relevant part of
    # the input. It can inherit tool access or receive a direct user grant.
    define tool: [mcp_tool]
    define invoker: [user, agent] or can_invoke from tool
    define can_invoke: invoker

# A project-tracker connector maps tool arguments to these application
# resources. The generic gateway receives only the relation/object checks.
type tracker_project
  relations
    define member: [user, agent]
    define viewer: member
    define can_read: viewer

type tracker_ticket
  relations
    define project: [tracker_project]
    define viewer: [user, agent] or viewer from project
    define can_read: viewer

type mission
  relations
    define requester: [user]
    define executor: [agent]
    define allowed_call: [mcp_call]
